[Unit]
Description=Journal a failed countersurveillance refresh survival check

[Service]
Type=oneshot
# Operator request (2026-11-01): no desktop popup; the failure is recorded in
# the user journal and visible via systemctl --user status.
ExecStart=systemd-cat -t cs-refresh-check /bin/echo "refresh survival check FAILED - see journalctl --user -u cs-refresh-check"
