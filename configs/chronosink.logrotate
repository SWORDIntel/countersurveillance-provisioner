# `su` is not optional here: logrotate refuses to touch a path whose parent
# directory it considers insecure (world or group writable), and this parent
# qualifies. Naming the owner is what lets rotation run at all; without it
# logrotate exits 1 and every other log on the host stops rotating too.
#
# This stanza covers the daemon's own evidence log. The QIHSE event spool is
# appended by the installer with whichever account actually owns that file: on a
# dataset with aclmode=discard only the owning UID may truncate, so a hardcoded
# owner breaks rotation wherever the two disagree.
/var/log/chronosink/*.jsonl {
    su chronosink chronosink
    rotate 7
    size 50M
    compress
    copytruncate
    missingok
    notifempty
}
