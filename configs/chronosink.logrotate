# `su` is not optional here: logrotate refuses to touch a path whose parent
# directory it considers insecure (world or group writable), and both of these
# parents qualify. Naming the owner is what lets rotation run at all; without it
# logrotate exits 1 and every other log on the host stops rotating too.
#
# Both sinks are owned by the daemon. On a dataset with aclmode=discard only the
# owning UID may write or truncate a file, so rotation must run as the daemon --
# even for the event spool, which QIHSE reads as root but cannot write.
/var/log/chronosink/*.jsonl {
    su chronosink chronosink
    rotate 7
    size 50M
    compress
    copytruncate
    missingok
    notifempty
}

/opt/qihse-data/events/*.jsonl {
    su chronosink chronosink
    rotate 7
    size 50M
    compress
    copytruncate
    missingok
    notifempty
}
