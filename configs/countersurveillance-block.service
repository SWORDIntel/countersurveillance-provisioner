[Unit]
Description=Counter-surveillance domain and network blocklist
Before=network-pre.target
Wants=network-pre.target
After=local-fs.target
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/nftables.d/countersurveillance.nft
ExecReload=/usr/sbin/nft -f /etc/nftables.d/countersurveillance.nft
ExecStop=-/usr/sbin/nft delete table inet countersurveillance

[Install]
WantedBy=multi-user.target
