# ChronoSink WireGuard Hub Configuration Template
# Interface definition for the Central Honeypot Node

[Interface]
Address = 10.200.0.1/24
ListenPort = 51820
PrivateKey = {{HUB_PRIVATE_KEY}}

# Policy routing for asymmetric return traffic preservation
PostUp = ip rule add iif %i table 200; ip route add default dev %i table 200; sysctl -w net.ipv4.ip_forward=1
PostDown = ip rule del iif %i table 200; ip route del default dev %i table 200

# Spoke Node 1
[Peer]
PublicKey = {{SPOKE_1_PUBLIC_KEY}}
AllowedIPs = 10.200.0.2/32

# Spoke Node 2
[Peer]
PublicKey = {{SPOKE_2_PUBLIC_KEY}}
AllowedIPs = 10.200.0.3/32

# Spoke Node 3
[Peer]
PublicKey = {{SPOKE_3_PUBLIC_KEY}}
AllowedIPs = 10.200.0.4/32
