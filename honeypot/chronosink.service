[Unit]
Description=ChronoSink Go Deception Honeypot & Evidence Telemetry Daemon
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/chronosink/chronosink
Restart=always
RestartSec=3
LimitNOFILE=65535

# Configuration files
EnvironmentFile=-/etc/default/chronosink
EnvironmentFile=-/etc/chronosink/chronosink.env

# Hardened Systemd Sandboxing
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true

# Resource Boundaries (Prevents Scanner Connection Floods)
MemoryMax=64M
TasksMax=256

# Linux Capabilities for Port Binding
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Writable log and event spool paths (prefixed with - to avoid namespace failure if dir absent)
ReadWritePaths=/var/log/chronosink -/opt/qihse-data/events /tmp

[Install]
WantedBy=multi-user.target
