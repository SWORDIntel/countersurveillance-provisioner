# ==============================================================================
# Counter-Surveillance & ChronoSink Deception Configuration
# ==============================================================================

# Deployment Mode for this PC:
#   local-daemon    : Runs ChronoSink Go binary locally on this PC as a systemd service
#   local-container : Runs ChronoSink inside a local Docker/Podman container
#   spoke-tunnel    : Intercepts probes on this PC and routes them across WireGuard to SINK_ENDPOINT
#   hub             : Configures this PC as the central ChronoSink Hub
DEPLOY_MODE="local-daemon"

# ------------------------------------------------------------------------------
# ChronoSink Target Endpoint Configuration (for spoke-tunnel mode)
# ------------------------------------------------------------------------------
# The IP address or FQDN of the sink (e.g. OCI public IP or on-premise server 192.168.1.95)
SINK_ENDPOINT="192.168.1.95"
SINK_WG_PORT="51820"
SINK_WG_IP="10.200.0.1"
SINK_WG_PUBKEY=""

# The local WireGuard overlay IP assigned to this specific PC
LOCAL_WG_IP="10.200.0.2"

# ------------------------------------------------------------------------------
# QIHSE Cluster & Citadel Shield Telemetry Target Configuration
# ------------------------------------------------------------------------------
# Ingestion paths:
# 1. Authoritative durable append to QIHSE events JSONL store
# 2. UDP datagram to Citadel Shield (t420:17872), triggering real-time KEYSTONE trigram indexing
QIHSE_EVENTS_FILE="/opt/qihse-data/events/countersurveillance_alerts.jsonl"
CITADEL_HOST="192.168.1.91"
CITADEL_PORT="17872"

# ------------------------------------------------------------------------------
# Port Configurations
# ------------------------------------------------------------------------------
# Lure ports for HTTP Deception & Gzip Bomb
CHRONOSINK_HTTP_PORTS="9080,8080,8443,80"

# Lure ports for Raw TCP Tarpit (SMB, Telnet, Winbox)
CHRONOSINK_RAW_PORTS="9445,23,445,5555,8291"
